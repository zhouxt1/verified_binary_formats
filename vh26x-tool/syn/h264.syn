# H.264 (V16, 06/2026) syntax tables, as vh26xc reads them.
#
# Each structure follows its table in clause 7.3 (or Annex E) line for line.
# After a descriptor, `range`/`eq` are the decoder-checked constraints of the
# semantics (7.4, E.2), with their clause; `confeq`/`conf` are the ones a
# decoder must not reject on. Assignments after an `else` are the
# semantics' inferences ("when not present, ... shall be inferred"), and the
# lines marked (7-n) are the derived variables of equation 7-n.
#
# Departures from the text, all syntactic:
# * `slice_type == B` is written `slice_type % 5 == 1` (Table 7-6), and so
#   on for P (0), I (2), SP (3), SI (4).
# * scaling_list( ) writes into ScalingList[ i ] for list i = 0..11
#   (ScalingList4x4[ i ] for i < 6, ScalingList8x8[ i - 6 ] after).
# * hrd_parameters( ) takes k = 0 (NAL) or 1 (VCL) and indexes its arrays
#   with it, so both structures stay in the environment.
# * An SEI message's payloadType and payloadSize are read as one 0xFF-byte
#   coded value each (the ff_byte loop and the last byte), and its payload
#   as bytes.
# * u(v) is written u( width ), the width being the one the semantics give.

array offset_for_ref_frame[256]
array seq_scaling_list_present_flag[12]
array pic_scaling_list_present_flag[12]
array ScalingList[12][64]
array UseDefaultScalingMatrixFlag[12]
array SeqScalingList[12][64]
array PicScalingList[12][64]
array bit_rate_value_minus1[2][32]
array cpb_size_value_minus1[2][32]
array cbr_flag[2][32]
array cpb_cnt_minus1[2]
array bit_rate_scale[2]
array cpb_size_scale[2]
array initial_cpb_removal_delay_length_minus1[2]
array cpb_removal_delay_length_minus1[2]
array dpb_output_delay_length_minus1[2]
array time_offset_length[2]
array run_length_minus1[8]
array top_left[8]
array bottom_right[8]
array delta_pic_order_cnt[2]
array luma_weight_l0[32]
array luma_offset_l0[32]
array chroma_weight_l0[32][2]
array chroma_offset_l0[32][2]
array luma_weight_l1[32]
array luma_offset_l1[32]
array chroma_weight_l1[32][2]
array chroma_offset_l1[32][2]
scalar slice_group_id
discard payload_byte, additional_extension2_data_flag, subset_sps_extension_bit
discard sps_extension_bit

# Tables 7-3 and 7-4, in zig-zag order.
table Default_4x4_Intra = { 6, 13, 13, 20, 20, 20, 28, 28, 28, 28, 32, 32, 32, 37, 37, 42 }
table Default_4x4_Inter = { 10, 14, 14, 20, 20, 20, 24, 24, 24, 24, 27, 27, 27, 30, 30, 34 }
table Default_8x8_Intra = {
     6, 10, 10, 13, 11, 13, 16, 16, 16, 16, 18, 18, 18, 18, 18, 23,
    23, 23, 23, 23, 23, 25, 25, 25, 25, 25, 25, 25, 27, 27, 27, 27,
    27, 27, 27, 27, 29, 29, 29, 29, 29, 29, 29, 31, 31, 31, 31, 31,
    31, 33, 33, 33, 33, 33, 36, 36, 36, 36, 38, 38, 38, 40, 40, 42 }
table Default_8x8_Inter = {
     9, 13, 13, 15, 13, 15, 17, 17, 17, 17, 19, 19, 19, 19, 19, 21,
    21, 21, 21, 21, 21, 22, 22, 22, 22, 22, 22, 22, 24, 24, 24, 24,
    24, 24, 24, 24, 25, 25, 25, 25, 25, 25, 25, 27, 27, 27, 27, 27,
    27, 28, 28, 28, 28, 28, 30, 30, 30, 30, 32, 32, 32, 33, 33, 35 }

# ---------------------------------------------------------------- 7.3.1

nal_unit_header() {
    forbidden_zero_bit                                  f(1)  eq(0)
    nal_ref_idc                                         u(2)
    nal_unit_type                                       u(5)
    IdrPicFlag = nal_unit_type == 5                     # (7-1)
}

# ------------------------------------------------------------- 7.3.2.1.1

seq_parameter_set_rbsp() {
    seq_parameter_set_data()
}

seq_parameter_set_data() {
    profile_idc                                         u(8)
    constraint_set0_flag                                u(1)
    constraint_set1_flag                                u(1)
    constraint_set2_flag                                u(1)
    constraint_set3_flag                                u(1)
    constraint_set4_flag                                u(1)
    conf(constraint_set4_flag == 0 || profile_idc == 77 || profile_idc == 88 || profile_idc == 100 || profile_idc == 110 || profile_idc == 118 || profile_idc == 128 || profile_idc == 134)
    constraint_set5_flag                                u(1)
    conf(constraint_set5_flag == 0 || profile_idc == 77 || profile_idc == 88 || profile_idc == 100 || profile_idc == 118)
    reserved_zero_2bits                                 u(2)  confeq(0)       # 7.4.2.1.1
    level_idc                                           u(8)
    seq_parameter_set_id                                ue(v) range(0, 31)
    if (profile_idc == 100 || profile_idc == 110 ||
        profile_idc == 122 || profile_idc == 244 || profile_idc == 44 ||
        profile_idc == 83 || profile_idc == 86 || profile_idc == 118 ||
        profile_idc == 128 || profile_idc == 138 || profile_idc == 139 ||
        profile_idc == 134 || profile_idc == 135) {
        chroma_format_idc                               ue(v) range(0, 3)
        if (chroma_format_idc == 3)
            separate_colour_plane_flag                  u(1)
        bit_depth_luma_minus8                           ue(v) range(0, 6)
        bit_depth_chroma_minus8                         ue(v) range(0, 6)
        qpprime_y_zero_transform_bypass_flag            u(1)
        seq_scaling_matrix_present_flag                 u(1)
        if (seq_scaling_matrix_present_flag)
            for (i = 0; i < ((chroma_format_idc != 3) ? 8 : 12); i++) {
                seq_scaling_list_present_flag[i]        u(1)
                if (seq_scaling_list_present_flag[i])
                    if (i < 6)
                        scaling_list(i, 16)
                    else
                        scaling_list(i, 64)
            }
    } else {
        chroma_format_idc = 1                           # 7.4.2.1.1
    }
    log2_max_frame_num_minus4                           ue(v) range(0, 12)
    pic_order_cnt_type                                  ue(v) range(0, 2)
    if (pic_order_cnt_type == 0)
        log2_max_pic_order_cnt_lsb_minus4               ue(v) range(0, 12)
    else if (pic_order_cnt_type == 1) {
        delta_pic_order_always_zero_flag                u(1)
        offset_for_non_ref_pic                          se(v)
        offset_for_top_to_bottom_field                  se(v)
        num_ref_frames_in_pic_order_cnt_cycle           ue(v) range(0, 255)
        for (i = 0; i < num_ref_frames_in_pic_order_cnt_cycle; i++)
            offset_for_ref_frame[i]                     se(v)
    }
    max_num_ref_frames                                  ue(v) range(0, 16)   # <= MaxDpbFrames <= 16 (A.3.1)
    gaps_in_frame_num_value_allowed_flag                u(1)
    # A.3.1 f), g) for the largest MaxFS of Table A-1 (139 264, levels 6 to
    # 6.2): PicWidthInMbs <= Sqrt( MaxFS * 8 ) = 1055.5, and the height of a
    # frame, which is at least that of its map units, too
    pic_width_in_mbs_minus1                             ue(v) range(0, 1054)
    pic_height_in_map_units_minus1                      ue(v) range(0, 1054)
    frame_mbs_only_flag                                 u(1)
    if (!frame_mbs_only_flag)
        mb_adaptive_frame_field_flag                    u(1)
    direct_8x8_inference_flag                           u(1)
    assert(frame_mbs_only_flag || direct_8x8_inference_flag)                 # 7.4.2.1.1
    frame_cropping_flag                                 u(1)
    if (frame_cropping_flag) {
        frame_crop_left_offset                          ue(v)
        frame_crop_right_offset                         ue(v)
        frame_crop_top_offset                           ue(v)
        frame_crop_bottom_offset                        ue(v)
    }
    vui_parameters_present_flag                         u(1)
    if (vui_parameters_present_flag)
        vui_parameters()
    sps_derived()
}

scaling_list(listIdx, sizeOfScalingList) {
    lastScale = 8
    nextScale = 8
    for (j = 0; j < sizeOfScalingList; j++) {
        if (nextScale != 0) {
            delta_scale                                 se(v) range(-128, 127)
            nextScale = (lastScale + delta_scale + 256) % 256
            UseDefaultScalingMatrixFlag[listIdx] = (j == 0 && nextScale == 0)
        }
        ScalingList[listIdx][j] = (nextScale == 0) ? lastScale : nextScale
        lastScale = ScalingList[listIdx][j]
    }
}

# The variables of 7.4.2.1.1, and the sequence-level scaling lists (fall-back
# rule set A, Table 7-2).
sps_derived() {
    ChromaArrayType = separate_colour_plane_flag == 1 ? 0 : chroma_format_idc
    SubWidthC = (chroma_format_idc == 1 || chroma_format_idc == 2) ? 2 : 1   # Table 6-1
    SubHeightC = chroma_format_idc == 1 ? 2 : 1
    MbWidthC = ChromaArrayType == 0 ? 0 : 16 / SubWidthC                    # (6-1)
    MbHeightC = ChromaArrayType == 0 ? 0 : 16 / SubHeightC                  # (6-2)
    BitDepthY = 8 + bit_depth_luma_minus8                                   # (7-3)
    QpBdOffsetY = 6 * bit_depth_luma_minus8                                 # (7-4)
    BitDepthC = 8 + bit_depth_chroma_minus8                                 # (7-5)
    QpBdOffsetC = 6 * bit_depth_chroma_minus8                               # (7-6)
    MaxFrameNum = 1 << (log2_max_frame_num_minus4 + 4)                      # (7-10)
    MaxPicOrderCntLsb = 1 << (log2_max_pic_order_cnt_lsb_minus4 + 4)        # (7-11)
    PicWidthInMbs = pic_width_in_mbs_minus1 + 1                             # (7-13)
    PicWidthInSamplesL = PicWidthInMbs * 16                                 # (7-14)
    PicWidthInSamplesC = PicWidthInMbs * MbWidthC                           # (7-15)
    PicHeightInMapUnits = pic_height_in_map_units_minus1 + 1                # (7-16)
    PicSizeInMapUnits = PicWidthInMbs * PicHeightInMapUnits                 # (7-17)
    FrameHeightInMbs = (2 - frame_mbs_only_flag) * PicHeightInMapUnits      # (7-18)
    assert(FrameHeightInMbs <= 1055)                                        # A.3.1 g)
    assert(PicWidthInMbs * FrameHeightInMbs <= 139264)                      # A.3.1 e)
    CropUnitX = ChromaArrayType == 0 ? 1 : SubWidthC                        # (7-19), (7-21)
    CropUnitY = ChromaArrayType == 0 ? 2 - frame_mbs_only_flag : SubHeightC * (2 - frame_mbs_only_flag)  # (7-20), (7-22)
    # 7.4.2.1.1: the cropping rectangle is inside the picture
    assert(frame_crop_left_offset <= PicWidthInSamplesL / CropUnitX - (frame_crop_right_offset + 1))
    assert(frame_crop_top_offset <= 16 * FrameHeightInMbs / CropUnitY - (frame_crop_bottom_offset + 1))
    CroppedWidth = PicWidthInSamplesL - CropUnitX * (frame_crop_left_offset + frame_crop_right_offset)   # (7-23)
    CroppedHeight = 16 * FrameHeightInMbs - CropUnitY * (frame_crop_top_offset + frame_crop_bottom_offset)  # (7-24)
    for (i = 0; i < 12; i++)
        for (j = 0; j < 64; j++) {
            if (!seq_scaling_matrix_present_flag)
                SeqScalingList[i][j] = 16                                   # Flat_4x4_16, Flat_8x8_16
            else if (seq_scaling_list_present_flag[i] && !UseDefaultScalingMatrixFlag[i])
                SeqScalingList[i][j] = ScalingList[i][j]
            else if (seq_scaling_list_present_flag[i] || i == 0 || i == 3 || i == 6 || i == 7)
                SeqScalingList[i][j] = i < 6 ? (j < 16 ? (i < 3 ? Default_4x4_Intra[j] : Default_4x4_Inter[j]) : 0)
                                             : (i % 2 == 0 ? Default_8x8_Intra[j] : Default_8x8_Inter[j])
            else if (i < 6)
                SeqScalingList[i][j] = SeqScalingList[i - 1][j]
            else
                SeqScalingList[i][j] = SeqScalingList[i - 2][j]
        }
}

# ----------------------------------------------------------------- E.1.1

vui_parameters() {
    aspect_ratio_info_present_flag                      u(1)
    if (aspect_ratio_info_present_flag) {
        aspect_ratio_idc                                u(8)
        if (aspect_ratio_idc == 255) {                  # Extended_SAR
            sar_width                                   u(16)
            sar_height                                  u(16)
        }
    }
    overscan_info_present_flag                          u(1)
    if (overscan_info_present_flag)
        overscan_appropriate_flag                       u(1)
    video_signal_type_present_flag                      u(1)
    if (video_signal_type_present_flag) {
        video_format                                    u(3)
        video_full_range_flag                           u(1)
        colour_description_present_flag                 u(1)
        if (colour_description_present_flag) {
            colour_primaries                            u(8)
            transfer_characteristics                    u(8)
            matrix_coefficients                         u(8)
        }
    } else {
        video_format = 5                                # E.2.1
    }
    if (!colour_description_present_flag) {
        colour_primaries = 2                            # E.2.1
        transfer_characteristics = 2
        matrix_coefficients = 2
    }
    chroma_loc_info_present_flag                        u(1)
    if (chroma_loc_info_present_flag) {
        chroma_sample_loc_type_top_field                ue(v) range(0, 5)
        chroma_sample_loc_type_bottom_field             ue(v) range(0, 5)
    }
    timing_info_present_flag                            u(1)
    if (timing_info_present_flag) {
        num_units_in_tick                               u(32) conf(num_units_in_tick > 0)
        time_scale                                      u(32) conf(time_scale > 0)
        fixed_frame_rate_flag                           u(1)
    }
    nal_hrd_parameters_present_flag                     u(1)
    if (nal_hrd_parameters_present_flag)
        hrd_parameters(0)
    vcl_hrd_parameters_present_flag                     u(1)
    if (vcl_hrd_parameters_present_flag)
        hrd_parameters(1)
    if (nal_hrd_parameters_present_flag || vcl_hrd_parameters_present_flag)
        low_delay_hrd_flag                              u(1)
    pic_struct_present_flag                             u(1)
    bitstream_restriction_flag                          u(1)
    motion_vectors_over_pic_boundaries_flag = 1         # E.2.1
    max_bytes_per_pic_denom = 2
    max_bits_per_mb_denom = 1
    log2_max_mv_length_horizontal = 15
    log2_max_mv_length_vertical = 15
    if (bitstream_restriction_flag) {
        motion_vectors_over_pic_boundaries_flag         u(1)
        max_bytes_per_pic_denom                         ue(v) range(0, 16)
        max_bits_per_mb_denom                           ue(v) range(0, 16)
        log2_max_mv_length_horizontal                   ue(v) range(0, 15)
        log2_max_mv_length_vertical                     ue(v) range(0, 15)
        max_num_reorder_frames                          ue(v)
        max_dec_frame_buffering                         ue(v) range(0, 16)   # <= MaxDpbFrames (E.2.1)
        assert(max_num_reorder_frames <= max_dec_frame_buffering)           # E.2.1
        assert(max_dec_frame_buffering >= max_num_ref_frames)               # E.2.1
    }
}

hrd_parameters(k) {
    cpb_cnt_minus1[k]                                   ue(v) range(0, 31)
    bit_rate_scale[k]                                   u(4)
    cpb_size_scale[k]                                   u(4)
    for (SchedSelIdx = 0; SchedSelIdx <= cpb_cnt_minus1[k]; SchedSelIdx++) {
        bit_rate_value_minus1[k][SchedSelIdx]           ue(v) range(0, 4294967294)
        conf(SchedSelIdx == 0 || bit_rate_value_minus1[k][SchedSelIdx] > bit_rate_value_minus1[k][SchedSelIdx - 1])
        cpb_size_value_minus1[k][SchedSelIdx]           ue(v) range(0, 4294967294)
        conf(SchedSelIdx == 0 || cpb_size_value_minus1[k][SchedSelIdx] <= cpb_size_value_minus1[k][SchedSelIdx - 1])
        cbr_flag[k][SchedSelIdx]                        u(1)
    }
    initial_cpb_removal_delay_length_minus1[k]          u(5)
    cpb_removal_delay_length_minus1[k]                  u(5)
    dpb_output_delay_length_minus1[k]                   u(5)
    time_offset_length[k]                               u(5)
}

# ------------------------------------------------------------- 7.3.2.1.2

seq_parameter_set_extension_rbsp() {
    seq_parameter_set_id                                ue(v) range(0, 31)
    aux_format_idc                                      ue(v) range(0, 3)
    if (aux_format_idc != 0) {
        bit_depth_aux_minus8                            ue(v) range(0, 4)
        alpha_incr_flag                                 u(1)
        alpha_opaque_value                              u(bit_depth_aux_minus8 + 9)
        alpha_transparent_value                         u(bit_depth_aux_minus8 + 9)
    }
    additional_extension_flag                           u(1)  confeq(0)
}

# ------------------------------------------------------------- 7.3.2.1.3
# The SVC, MVC and 3D-AVC extensions (Annexes F-I) are kept as bits.

subset_seq_parameter_set_rbsp() {
    seq_parameter_set_data()
    while (more_rbsp_data())
        subset_sps_extension_bit                        u(1)
}

# ---------------------------------------------------------------- 7.3.2.2

pic_parameter_set_ids() {
    pic_parameter_set_id                                ue(v) range(0, 255)
    seq_parameter_set_id                                ue(v) range(0, 31)
}

pic_parameter_set_rbsp() {
    pic_parameter_set_id                                ue(v) range(0, 255)
    seq_parameter_set_id                                ue(v) range(0, 31)
    entropy_coding_mode_flag                            u(1)
    bottom_field_pic_order_in_frame_present_flag        u(1)
    num_slice_groups_minus1                             ue(v) range(0, 7)    # A.2.1
    if (num_slice_groups_minus1 > 0) {
        slice_group_map_type                            ue(v) range(0, 6)
        assert(num_slice_groups_minus1 == 1 || slice_group_map_type < 3 || slice_group_map_type > 5)
        if (slice_group_map_type == 0)
            for (iGroup = 0; iGroup <= num_slice_groups_minus1; iGroup++)
                run_length_minus1[iGroup]               ue(v) range(0, PicSizeInMapUnits - 1)
        else if (slice_group_map_type == 2)
            for (iGroup = 0; iGroup < num_slice_groups_minus1; iGroup++) {
                top_left[iGroup]                        ue(v)
                bottom_right[iGroup]                    ue(v)
                assert(top_left[iGroup] <= bottom_right[iGroup] && bottom_right[iGroup] < PicSizeInMapUnits)
                assert(top_left[iGroup] % PicWidthInMbs <= bottom_right[iGroup] % PicWidthInMbs)
            }
        else if (slice_group_map_type == 3 ||
                 slice_group_map_type == 4 ||
                 slice_group_map_type == 5) {
            slice_group_change_direction_flag           u(1)
            slice_group_change_rate_minus1              ue(v) range(0, PicSizeInMapUnits - 1)
        } else if (slice_group_map_type == 6) {
            pic_size_in_map_units_minus1                ue(v) eq(PicSizeInMapUnits - 1)
            for (i = 0; i <= pic_size_in_map_units_minus1; i++)
                slice_group_id[i]                       u(Ceil(Log2(num_slice_groups_minus1 + 1))) range(0, num_slice_groups_minus1)
        }
    }
    num_ref_idx_l0_default_active_minus1                ue(v) range(0, 31)
    num_ref_idx_l1_default_active_minus1                ue(v) range(0, 31)
    weighted_pred_flag                                  u(1)
    weighted_bipred_idc                                 u(2)  range(0, 2)
    pic_init_qp_minus26                                 se(v) range(-(26 + QpBdOffsetY), 25)
    pic_init_qs_minus26                                 se(v) range(-26, 25)
    chroma_qp_index_offset                              se(v) range(-12, 12)
    deblocking_filter_control_present_flag              u(1)
    constrained_intra_pred_flag                         u(1)
    redundant_pic_cnt_present_flag                      u(1)
    second_chroma_qp_index_offset = chroma_qp_index_offset   # 7.4.2.2
    if (more_rbsp_data()) {
        transform_8x8_mode_flag                         u(1)
        pic_scaling_matrix_present_flag                 u(1)
        if (pic_scaling_matrix_present_flag)
            for (i = 0; i < 6 + ((chroma_format_idc != 3) ? 2 : 6) * transform_8x8_mode_flag; i++) {
                pic_scaling_list_present_flag[i]        u(1)
                if (pic_scaling_list_present_flag[i])
                    if (i < 6)
                        scaling_list(i, 16)
                    else
                        scaling_list(i, 64)
            }
        second_chroma_qp_index_offset                   se(v) range(-12, 12)
    }
    pps_derived()
}

# The picture-level scaling lists (7.4.2.2; Table 7-2, fall-back rule A
# without a sequence-level scaling matrix, B with one).
pps_derived() {
    for (i = 0; i < 12; i++)
        for (j = 0; j < 64; j++) {
            if (!pic_scaling_matrix_present_flag)
                PicScalingList[i][j] = SeqScalingList[i][j]
            else if (pic_scaling_list_present_flag[i] && !UseDefaultScalingMatrixFlag[i])
                PicScalingList[i][j] = ScalingList[i][j]
            else if (pic_scaling_list_present_flag[i] ||
                     (!seq_scaling_matrix_present_flag && (i == 0 || i == 3 || i == 6 || i == 7)))
                PicScalingList[i][j] = i < 6 ? (j < 16 ? (i < 3 ? Default_4x4_Intra[j] : Default_4x4_Inter[j]) : 0)
                                             : (i % 2 == 0 ? Default_8x8_Intra[j] : Default_8x8_Inter[j])
            else if (i == 0 || i == 3 || i == 6 || i == 7)
                PicScalingList[i][j] = SeqScalingList[i][j]
            else if (i < 6)
                PicScalingList[i][j] = PicScalingList[i - 1][j]
            else
                PicScalingList[i][j] = PicScalingList[i - 2][j]
        }
}

# ---------------------------------------------------------------- 7.3.2.3

sei_rbsp() {
    do
        sei_message()
    while (more_rbsp_data())
}

sei_message() {
    payloadType                                         ff
    payloadSize                                         ff
    for (i = 0; i < payloadSize; i++)
        payload_byte                                    u(8)
}

# ------------------------------------------------------------ 7.3.2.4 - 7

access_unit_delimiter_rbsp() {
    primary_pic_type                                    u(3)
}

filler_data_rbsp() {
    while (more_rbsp_data())
        ff_byte                                         f(8)  eq(255)
}

# ------------------------------------------------------------------ 7.3.3

slice_header_ids() {
    first_mb_in_slice                                   ue(v)
    slice_type                                          ue(v) range(0, 9)
    pic_parameter_set_id                                ue(v) range(0, 255)
}

slice_header() {
    first_mb_in_slice                                   ue(v)
    slice_type                                          ue(v) range(0, 9)
    assert(!IdrPicFlag || slice_type % 5 == 2 || slice_type % 5 == 4)      # 7.4.3
    assert(max_num_ref_frames > 0 || slice_type % 5 == 2 || slice_type % 5 == 4)
    pic_parameter_set_id                                ue(v) range(0, 255)
    if (separate_colour_plane_flag == 1)
        colour_plane_id                                 u(2)  range(0, 2)
    frame_num                                           u(log2_max_frame_num_minus4 + 4)
    if (!frame_mbs_only_flag) {
        field_pic_flag                                  u(1)
        if (field_pic_flag)
            bottom_field_flag                           u(1)
    }
    MbaffFrameFlag = mb_adaptive_frame_field_flag && !field_pic_flag         # (7-25)
    PicHeightInMbs = FrameHeightInMbs / (1 + field_pic_flag)                 # (7-26)
    PicSizeInMbs = PicWidthInMbs * PicHeightInMbs                            # (7-28)
    MaxPicNum = field_pic_flag == 0 ? MaxFrameNum : 2 * MaxFrameNum          # 7.4.3.1
    # A long_term_pic_num is some picture's LongTermPicNum (7.4.3.1,
    # 7.4.3.3): LongTermFrameIdx, or 2 * LongTermFrameIdx + 1 for a field
    # (8-29, 8-32), and LongTermFrameIdx <= MaxLongTermFrameIdx
    # <= max_num_ref_frames - 1 (7.4.3.3)
    MaxLongTermPicNum = field_pic_flag == 0 ? max_num_ref_frames - 1 : 2 * max_num_ref_frames - 1
    assert(first_mb_in_slice * (1 + MbaffFrameFlag) < PicSizeInMbs)          # 7.4.3
    if (IdrPicFlag)
        idr_pic_id                                      ue(v) range(0, 65535)
    if (pic_order_cnt_type == 0) {
        pic_order_cnt_lsb                               u(log2_max_pic_order_cnt_lsb_minus4 + 4)
        if (bottom_field_pic_order_in_frame_present_flag && !field_pic_flag)
            delta_pic_order_cnt_bottom                  se(v)
    }
    if (pic_order_cnt_type == 1 && !delta_pic_order_always_zero_flag) {
        delta_pic_order_cnt[0]                          se(v)
        if (bottom_field_pic_order_in_frame_present_flag && !field_pic_flag)
            delta_pic_order_cnt[1]                      se(v)
    }
    if (redundant_pic_cnt_present_flag)
        redundant_pic_cnt                               ue(v) range(0, 127)
    if (slice_type % 5 == 1)
        direct_spatial_mv_pred_flag                     u(1)
    num_ref_idx_l0_active_minus1 = num_ref_idx_l0_default_active_minus1    # 7.4.3
    num_ref_idx_l1_active_minus1 = num_ref_idx_l1_default_active_minus1
    if (slice_type % 5 == 0 || slice_type % 5 == 3 || slice_type % 5 == 1) {
        num_ref_idx_active_override_flag                u(1)
        if (num_ref_idx_active_override_flag) {
            num_ref_idx_l0_active_minus1                ue(v) range(0, 31)
            if (slice_type % 5 == 1)
                num_ref_idx_l1_active_minus1            ue(v) range(0, 31)
        }
    }
    # 7.4.3: 0 to 15 for a frame, 0 to 31 for a field
    assert(num_ref_idx_l0_active_minus1 <= (field_pic_flag ? 31 : 15))
    assert(num_ref_idx_l1_active_minus1 <= (field_pic_flag ? 31 : 15))
    # ref_pic_list_mvc_modification( ) is for nal_unit_type 20 and 21, which
    # vh26x keeps as bytes.
    ref_pic_list_modification()
    if ((weighted_pred_flag && (slice_type % 5 == 0 || slice_type % 5 == 3)) ||
        (weighted_bipred_idc == 1 && slice_type % 5 == 1))
        pred_weight_table()
    if (nal_ref_idc != 0)
        dec_ref_pic_marking()
    if (entropy_coding_mode_flag && slice_type % 5 != 2 && slice_type % 5 != 4)
        cabac_init_idc                                  ue(v) range(0, 2)
    slice_qp_delta                                      se(v)
    SliceQPY = 26 + pic_init_qp_minus26 + slice_qp_delta                     # (7-30)
    assert(-QpBdOffsetY <= SliceQPY && SliceQPY <= 51)
    if (slice_type % 5 == 3 || slice_type % 5 == 4) {
        if (slice_type % 5 == 3)
            sp_for_switch_flag                          u(1)
        slice_qs_delta                                  se(v)
        QSY = 26 + pic_init_qs_minus26 + slice_qs_delta
        assert(0 <= QSY && QSY <= 51)
    }
    if (deblocking_filter_control_present_flag) {
        disable_deblocking_filter_idc                   ue(v) range(0, 2)
        if (disable_deblocking_filter_idc != 1) {
            slice_alpha_c0_offset_div2                  se(v) range(-6, 6)
            slice_beta_offset_div2                      se(v) range(-6, 6)
        }
    }
    if (num_slice_groups_minus1 > 0 &&
        slice_group_map_type >= 3 && slice_group_map_type <= 5) {
        SliceGroupChangeRate = slice_group_change_rate_minus1 + 1           # (7-32)
        slice_group_change_cycle                        u(Ceil(Log2((PicSizeInMapUnits + SliceGroupChangeRate - 1) / SliceGroupChangeRate + 1)))
        assert(slice_group_change_cycle <= (PicSizeInMapUnits + SliceGroupChangeRate - 1) / SliceGroupChangeRate)
    }
}

ref_pic_list_modification() {
    if (slice_type % 5 != 2 && slice_type % 5 != 4) {
        ref_pic_list_modification_flag_l0               u(1)
        if (ref_pic_list_modification_flag_l0) {
            numModifications = 0
            do {
                modification_of_pic_nums_idc            ue(v) range(0, 3)
                if (modification_of_pic_nums_idc == 0 ||
                    modification_of_pic_nums_idc == 1)
                    abs_diff_pic_num_minus1             ue(v) range(0, MaxPicNum - 1)
                else if (modification_of_pic_nums_idc == 2)
                    long_term_pic_num                   ue(v) range(0, MaxLongTermPicNum)
                if (modification_of_pic_nums_idc != 3)
                    numModifications++
                assert(numModifications <= num_ref_idx_l0_active_minus1 + 1)   # 7.4.3.1
            } while (modification_of_pic_nums_idc != 3)
        }
    }
    if (slice_type % 5 == 1) {
        ref_pic_list_modification_flag_l1               u(1)
        if (ref_pic_list_modification_flag_l1) {
            numModifications = 0
            do {
                modification_of_pic_nums_idc            ue(v) range(0, 3)
                if (modification_of_pic_nums_idc == 0 ||
                    modification_of_pic_nums_idc == 1)
                    abs_diff_pic_num_minus1             ue(v) range(0, MaxPicNum - 1)
                else if (modification_of_pic_nums_idc == 2)
                    long_term_pic_num                   ue(v) range(0, MaxLongTermPicNum)
                if (modification_of_pic_nums_idc != 3)
                    numModifications++
                assert(numModifications <= num_ref_idx_l1_active_minus1 + 1)
            } while (modification_of_pic_nums_idc != 3)
        }
    }
}

pred_weight_table() {
    luma_log2_weight_denom                              ue(v) range(0, 7)
    if (ChromaArrayType != 0)
        chroma_log2_weight_denom                        ue(v) range(0, 7)
    for (i = 0; i <= num_ref_idx_l0_active_minus1; i++) {
        luma_weight_l0_flag                             u(1)
        if (luma_weight_l0_flag) {
            luma_weight_l0[i]                           se(v) range(-128, 127)
            luma_offset_l0[i]                           se(v) range(-128, 127)
        } else {
            luma_weight_l0[i] = 1 << luma_log2_weight_denom    # 7.4.3.2
            luma_offset_l0[i] = 0
        }
        if (ChromaArrayType != 0) {
            chroma_weight_l0_flag                       u(1)
            if (chroma_weight_l0_flag)
                for (j = 0; j < 2; j++) {
                    chroma_weight_l0[i][j]              se(v) range(-128, 127)
                    chroma_offset_l0[i][j]              se(v) range(-128, 127)
                }
            else
                for (j = 0; j < 2; j++) {
                    chroma_weight_l0[i][j] = 1 << chroma_log2_weight_denom
                    chroma_offset_l0[i][j] = 0
                }
        }
    }
    if (slice_type % 5 == 1)
        for (i = 0; i <= num_ref_idx_l1_active_minus1; i++) {
            luma_weight_l1_flag                         u(1)
            if (luma_weight_l1_flag) {
                luma_weight_l1[i]                       se(v) range(-128, 127)
                luma_offset_l1[i]                       se(v) range(-128, 127)
            } else {
                luma_weight_l1[i] = 1 << luma_log2_weight_denom
                luma_offset_l1[i] = 0
            }
            if (ChromaArrayType != 0) {
                chroma_weight_l1_flag                   u(1)
                if (chroma_weight_l1_flag)
                    for (j = 0; j < 2; j++) {
                        chroma_weight_l1[i][j]          se(v) range(-128, 127)
                        chroma_offset_l1[i][j]          se(v) range(-128, 127)
                    }
                else
                    for (j = 0; j < 2; j++) {
                        chroma_weight_l1[i][j] = 1 << chroma_log2_weight_denom
                        chroma_offset_l1[i][j] = 0
                    }
            }
        }
}

dec_ref_pic_marking() {
    if (IdrPicFlag) {
        no_output_of_prior_pics_flag                    u(1)
        long_term_reference_flag                        u(1)
    } else {
        adaptive_ref_pic_marking_mode_flag              u(1)
        numMmco1or3 = 0
        numMmco2 = 0
        numMmco4 = 0
        numMmco5 = 0
        numMmco6 = 0
        if (adaptive_ref_pic_marking_mode_flag)
            do {
                memory_management_control_operation     ue(v) range(0, 6)
                # 7.4.3.3: at most one 4, one 5 and one 6; no 5 with any of 1
                # to 3, nor after a 6; and each 1 or 3 marks a different
                # short-term reference picture (there are at most
                # max_num_ref_frames frames, twice as many fields), each 2
                # a long-term one (of those, or one a 3 made long-term)
                if (memory_management_control_operation == 1 || memory_management_control_operation == 3)
                    numMmco1or3++
                if (memory_management_control_operation == 2)
                    numMmco2++
                if (memory_management_control_operation == 4)
                    numMmco4++
                if (memory_management_control_operation == 5) {
                    assert(numMmco6 == 0)
                    numMmco5++
                }
                if (memory_management_control_operation == 6)
                    numMmco6++
                assert(numMmco4 <= 1 && numMmco5 <= 1 && numMmco6 <= 1)
                assert(numMmco5 == 0 || numMmco1or3 == 0)
                assert(numMmco1or3 <= (1 + field_pic_flag) * max_num_ref_frames)
                assert(numMmco2 <= (1 + field_pic_flag) * max_num_ref_frames + numMmco1or3)
                if (memory_management_control_operation == 1 ||
                    memory_management_control_operation == 3)
                    difference_of_pic_nums_minus1       ue(v)
                if (memory_management_control_operation == 2)
                    long_term_pic_num                   ue(v) range(0, MaxLongTermPicNum)
                if (memory_management_control_operation == 3 ||
                    memory_management_control_operation == 6)
                    long_term_frame_idx                 ue(v) range(0, max_num_ref_frames - 1)
                if (memory_management_control_operation == 4)
                    max_long_term_frame_idx_plus1       ue(v) range(0, max_num_ref_frames)
            } while (memory_management_control_operation != 0)
    }
}

# 7.3.2.9.1: slice_header( ), then slice_id.
slice_data_partition_a_header() {
    slice_header()
    slice_id                                            ue(v)
}

# 7.3.2.9.2, 7.3.2.9.3
slice_data_partition_bc_header() {
    slice_id                                            ue(v)
    if (separate_colour_plane_flag == 1)
        colour_plane_id                                 u(2)  range(0, 2)
    if (redundant_pic_cnt_present_flag)
        redundant_pic_cnt                               ue(v) range(0, 127)
}

# --------------------------------------------------------------- programs

program nal = nal_unit_header()
program sps = seq_parameter_set_rbsp() uses nal
program sps_ext = seq_parameter_set_extension_rbsp()
program subset_sps = subset_seq_parameter_set_rbsp() uses nal
program pps_ids = pic_parameter_set_ids()
program pps = pic_parameter_set_rbsp() uses nal, sps
program sei = sei_rbsp()
program aud = access_unit_delimiter_rbsp()
program filler = filler_data_rbsp()
program slice_ids = slice_header_ids()
program slice = slice_header() uses nal, sps, pps
program slice_a = slice_data_partition_a_header() uses nal, sps, pps
program slice_bc = slice_data_partition_bc_header() uses nal, sps, pps
